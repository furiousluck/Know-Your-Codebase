PORT=8787
CLIENT_ORIGIN=http://127.0.0.1:5173

# MongoDB is recommended. If omitted, the server uses an in-memory store for local demos.
MONGODB_URI=mongodb://127.0.0.1:27017/codebase-rag
MONGODB_CONNECT_TIMEOUT_MS=8000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_STARTUP_TIMEOUT_MS=10000

# GitHub is optional for public repos. Add a token for private repos or higher rate limits.
GITHUB_TOKEN=

# Gemini embeddings. The server uses a deterministic local fallback when this is omitted.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_FALLBACK_ON_ERROR=true

# OpenRouter Q&A. Use a free model slug, for example openrouter/free or another :free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=2400
OPENROUTER_SITE_URL=http://127.0.0.1:5173
OPENROUTER_APP_NAME=Codebase RAG Phase 1

MAX_FILE_BYTES=400000
MAX_SOURCE_FILE_BYTES=600000
MAX_TEST_FILE_BYTES=450000
MAX_DOC_FILE_BYTES=300000
MAX_CONFIG_FILE_BYTES=140000
MAX_SCHEMA_FILE_BYTES=350000
MAX_MANIFEST_FILE_BYTES=250000
MAX_INDEX_FILES=800
CHUNK_TARGET_LINES=80
CHUNK_OVERLAP_LINES=12
INDEX_LOCK_TTL_MS=900000
